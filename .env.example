# ── PostgreSQL (Docker) ──
# 실제 값은 .env 에 넣는다 (.env 는 커밋하지 않음)
POSTGRES_DB=gym
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=change_me

# 호스트로 노출할 포트 (로컬 PostgreSQL과 충돌 시 5433 등으로 변경)
DB_HOST_PORT=5432

# ── JWT ──
# HS256 최소 256비트(32바이트) 이상의 랜덤 문자열
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_bytes
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=3600

# ── 첫 관리자 계정 시딩 ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
